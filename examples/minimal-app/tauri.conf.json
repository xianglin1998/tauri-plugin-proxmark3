{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minimal-app",
  "version": "0.1.0",
  "identifier": "dev.proxmark3.minimal",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tauri-plugin-proxmark3 minimal app",
        "width": 520,
        "height": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
